<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([['name' => $this->_('Ike.add_module_row', true), 'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addrow/' . $this->Html->safe($module->id)]]]);
$this->Widget->create($this->_('Ike.manage.module_rows_title', true), ['id' => 'manage_ike']);
?>
<div class="title_row first"><h3><?php $this->_('Ike.manage.module_rows_title'); ?></h3></div>
<?php if (!empty($module->rows)) { ?>
<table class="table">
    <tr class="heading_row">
        <td><?php $this->_('Ike.manage.module_rows_heading.hostname'); ?></td>
        <td class="last"><?php $this->_('Ike.manage.module_rows_heading.options'); ?></td>
    </tr>
    <?php foreach ($module->rows as $row) { ?>
    <tr>
        <td><?php echo $this->Html->safe($row->meta->hostname . ':' . $row->meta->port); ?></td>
        <td>
            <a href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/editrow/' . $module->id . '/' . $row->id . '/'); ?>"><?php $this->_('Ike.manage.module_rows.edit'); ?></a>
            <?php
            $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/');
            $this->Form->fieldHidden('id', $module->id);
            $this->Form->fieldHidden('row_id', $row->id);
            ?>
            <a href="#" class="manage" rel="delete"><?php $this->_('Ike.manage.module_rows.delete'); ?></a>
            <?php $this->Form->end(); ?>
        </td>
    </tr>
    <?php } ?>
</table>
<?php } else { ?>
<div class="empty_section"><div class="empty_box"><?php $this->_('Ike.manage.module_rows_no_results'); ?></div></div>
<?php }
$this->Widget->end();
